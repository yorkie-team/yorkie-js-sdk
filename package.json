{
  "name": "yorkie-js",
  "version": "0.0.0",
  "private": true,
  "description": "A collection of tools and examples for Yorkie",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "build:examples": "pnpm --filter './examples/*' run build",
    "build:packages": "pnpm --filter './packages/*' run build",
    "lint": "eslint . --fix --max-warnings=0 --flag v10_config_lookup_from_file",
    "verify:doc-links": "node ./scripts/verify-doc-links.mjs",
    "test:scripts": "node --test 'scripts/test/**/*.test.mjs'",
    "sdk": "pnpm --filter=@yorkie-js/sdk",
    "devtools": "pnpm --filter=@yorkie-js/devtools",
    "react": "pnpm --filter=@yorkie-js/react",
    "prosemirror": "pnpm --filter=@yorkie-js/prosemirror",
    "schema": "pnpm --filter=@yorkie-js/schema",
    "vanilla-codemirror6": "pnpm --filter=vanilla-codemirror6",
    "vanilla-quill": "pnpm --filter=vanilla-quill",
    "vanilla-prosemirror": "pnpm --filter=vanilla-prosemirror",
    "vanilla-document-limit": "pnpm --filter=vanilla-document-limit",
    "profile-stack": "pnpm --filter=profile-stack",
    "simultaneous-cursors": "pnpm --filter=simultaneous-cursors",
    "react-tldraw": "pnpm --filter=react-tldraw",
    "react-flow": "pnpm --filter=react-flow",
    "react-document-limit": "pnpm --filter=react-document-limit",
    "react-todomvc": "pnpm --filter=react-todomvc",
    "react-revision": "pnpm --filter=react-revision",
    "nextjs-scheduler": "pnpm --filter=nextjs-scheduler",
    "nextjs-todolist": "pnpm --filter=nextjs-todolist",
    "nextjs-presence": "pnpm --filter=nextjs-presence",
    "vuejs-kanban": "pnpm --filter=vuejs-kanban"
  },
  "keywords": [],
  "author": {
    "name": "hackerwins",
    "email": "susukang98@gmail.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "only-allow": "^1.2.2",
    "typescript-eslint": "^8.59.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "@humanfs/node@<0.16.8": ">=0.16.8 <0.17.0",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1 <6.0.0",
      "ajv@>=7.0.0 <8.18.0": ">=8.18.0 <9.0.0",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0 <3.0.0",
      "bn.js@<4.12.3": ">=4.12.3 <5.0.0",
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.3 <6.0.0",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3.0.0",
      "brace-expansion@<1.1.16": ">=1.1.16 <2.0.0",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3.0.0",
      "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9 <6.0.0",
      "browserslist@<=4.28.6": ">=4.28.7 <5.0.0",
      "content-security-policy-parser@<0.6.0": ">=0.6.0 <1.0.0",
      "devalue@<5.6.4": ">=5.6.4 <6.0.0",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4 <5.0.0",
      "diff@>=6.0.0 <8.0.3": ">=8.0.3 <9.0.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29.0",
      "fflate@>=0.8.0 <0.8.3": ">=0.8.3 <0.9.0",
      "flatted@<3.4.2": ">=3.4.2 <4.0.0",
      "follow-redirects@<1.16.0": ">=1.16.0 <2.0.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6 <5.0.0",
      "immutable@>=5.0.0-beta.1 <5.1.8": ">=5.1.8 <6.0.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",
      "linkify-it@<=5.0.1": ">=5.0.2 <6.0.0",
      "lodash@<4.18.0": ">=4.18.0 <5.0.0",
      "lodash-es@<4.18.0": ">=4.18.0 <5.0.0",
      "markdown-it@<=14.1.1": ">=14.2.0 <15.0.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10.0.0",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3 <11.0.0",
      "msgpackr@<1.10.1": ">=1.10.1 <2.0.0",
      "nanoid@<3.3.18": ">=3.3.18 <4.0.0",
      "path-to-regexp@<8.4.0": ">=8.4.0 <9.0.0",
      "picomatch@<2.3.2": ">=2.3.2 <3.0.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5.0.0",
      "postcss@<=8.5.22": ">=8.5.23 <9.0.0",
      "qs@<6.16.0": ">=6.16.0 <7.0.0",
      "rollup@>=3.0.0 <3.30.0": ">=3.30.0 <4.0.0",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0 <5.0.0",
      "sharp@<0.35.4": ">=0.35.4 <0.36.0",
      "svelte@<=5.55.6": ">=5.55.7 <6.0.0",
      "svgo@>=1.0.0 <2.8.4": ">=2.8.4 <3.0.0",
      "tsup@<=8.3.4": ">=8.4.0 <9.0.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9.0.0",
      "yaml@<1.10.3": ">=1.10.3 <2.0.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3 <3.0.0"
    }
  }
}
